erDiagram
    customers ||--o{ onboarding_records : "has many"
    document_types ||--o{ onboarding_records : "classifies"
    onboarding_records ||--o{ onboarding_flags : "has reasons for review"
    onboarding_records ||--o{ onboarding_reviews : "has operator decisions"
    onboarding_records ||--o| onboarding_erasures : "may be anonymized"

    customers {
        bigint id PK
        varchar email UK
        datetime created_at
    }
    document_types {
        tinyint id PK
        varchar code UK "DNI, CE, PASSPORT, OTHER"
        varchar name
    }
    onboarding_records {
        bigint id PK
        bigint customer_id FK
        tinyint document_type_id FK
        varchar full_name
        varchar document_number
        decimal ocr_confidence "0-100"
        enum status "VERIFIED, NEEDS_REVIEW"
        char image_sha256
        varchar original_filename
        datetime created_at "UTC"
    }
    onboarding_flags {
        bigint id PK
        bigint onboarding_id FK
        varchar code "LOW_CONFIDENCE, INVALID_DOCUMENT_NUMBER, DUPLICATE_DOCUMENT, DUPLICATE_IMAGE"
        datetime created_at "UTC"
    }
    onboarding_reviews {
        bigint id PK
        bigint onboarding_id FK
        enum decision "APPROVED, REJECTED"
        varchar reviewer
        varchar review_comment
        datetime created_at "UTC"
    }
    onboarding_erasures {
        bigint onboarding_id PK, FK
        varchar erased_by "operator or retention job"
        varchar reason
        datetime created_at "UTC"
    }
    v_onboarding_details {
        view read_model "record + customer + flags + latest decision + erasure"
        enum effective_status "VERIFIED, NEEDS_REVIEW, APPROVED, REJECTED, ERASED"
    }
