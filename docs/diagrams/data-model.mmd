erDiagram
    customers ||--o{ onboarding_records : "has many"
    document_types ||--o{ onboarding_records : "classifies"

    customers {
        bigint id PK
        varchar email UK
        datetime created_at
    }
    document_types {
        tinyint id PK
        varchar code UK "DNI, CE, PASSPORT, OTHER"
        varchar name
    }
    onboarding_records {
        bigint id PK
        bigint customer_id FK
        tinyint document_type_id FK
        varchar full_name
        varchar document_number
        decimal ocr_confidence "0-100"
        enum status "VERIFIED, NEEDS_REVIEW"
        char image_sha256
        varchar original_filename
        datetime created_at "UTC"
    }
