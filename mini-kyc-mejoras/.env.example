# Copy to .env and fill in. NEVER commit the real .env file.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-locally
DB_NAME=mini_kyc

# --- AI / OCR (Google AI Studio API key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any Gemini Flash model your key can use. The alias below always points to the latest Flash.
GEMINI_MODEL=gemini-flash-latest
# Used when the primary model keeps failing (empty disables the fallback), and retry tuning.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=40
# GEMINI_MAX_ATTEMPTS=3
# "gemini" (real OCR) or "mock" (fake fixed data, for demos/tests only)
OCR_PROVIDER=gemini

# --- Operator review: secret for the /api/v1/reviews endpoints (empty = disabled) ---
REVIEW_API_KEY=

# --- Optional tuning ---
# DUPLICATE_CHECK_ENABLED=true
# BLUR_THRESHOLD=25
# MIN_VERIFIED_CONFIDENCE=0.85
# CORS_ORIGINS=http://localhost:5173
# AUTO_MIGRATE=true
